# ──────────────────────────────────────────────────────────────
# DATABASE
# ──────────────────────────────────────────────────────────────
DB_URL=jdbc:postgresql://localhost:5432/finalbid
DB_USERNAME=finalbid
DB_PASSWORD=changeme

# ──────────────────────────────────────────────────────────────
# JWT
# ──────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
JWT_SECRET=replace-with-base64-encoded-32-byte-random-secret
JWT_ACCESS_EXPIRY_MS=900000
JWT_REFRESH_EXPIRY_DAYS=7

# ──────────────────────────────────────────────────────────────
# REDIS
# ──────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379

# ──────────────────────────────────────────────────────────────
# AWS — General
# ──────────────────────────────────────────────────────────────
AWS_REGION=eu-central-1
AWS_ENDPOINT_OVERRIDE=http://localhost:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# ──────────────────────────────────────────────────────────────
# S3
# ──────────────────────────────────────────────────────────────
AWS_S3_BUCKET=finalbid-images

# ──────────────────────────────────────────────────────────────
# SNS topic ARNs (used on AWS profile; ignored locally)
# ──────────────────────────────────────────────────────────────
SNS_USER_REGISTERED_ARN=arn:aws:sns:eu-central-1:000000000000:finalbid-user-registered
SNS_BID_PLACED_ARN=arn:aws:sns:eu-central-1:000000000000:finalbid-bid-placed
SNS_AUCTION_ENDED_ARN=arn:aws:sns:eu-central-1:000000000000:finalbid-auction-ended

# ──────────────────────────────────────────────────────────────
# SQS queue URLs (used on AWS profile by notification-service)
# ──────────────────────────────────────────────────────────────
SQS_USER_REGISTERED_URL=http://localhost:4566/000000000000/finalbid-notification-user-registered
SQS_BID_PLACED_URL=http://localhost:4566/000000000000/finalbid-notification-bid-placed
SQS_AUCTION_ENDED_URL=http://localhost:4566/000000000000/finalbid-notification-auction-ended

# ──────────────────────────────────────────────────────────────
# EMAIL
# ──────────────────────────────────────────────────────────────
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
FROM_EMAIL=noreply@finalbid.com

# ──────────────────────────────────────────────────────────────
# CORS
# ──────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost

# ──────────────────────────────────────────────────────────────
# APP
# ──────────────────────────────────────────────────────────────
BASE_URL=http://localhost
SPRING_PROFILES_ACTIVE=default
